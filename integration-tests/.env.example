# Environment: sandbox | beta | production
ENVIRONMENT=production

# Override the App base URL used for the Flutter /signin page.
#
# IMPORTANT: the real app subdomain is a DEPLOY-TIME value. The join_page
# environment.ts ships `appUrl` as a REPLACE_WITH_APP_URL placeholder, so the
# source tree does NOT reveal the actual app URL. The default below is a best
# guess from the join_page apex (https://trainwithjoe.app). CONFIRM the deployed
# app URL and set this if it differs.
# APP_BASE_URL=https://app.trainwithjoe.app

# Override the join_page register URL (optional). Registration is an INLINE form
# on the HOME page (section#register), NOT a /register route — so this should be
# the home page URL. Defaults based on ENVIRONMENT: https://trainwithjoe.app/ for
# prod, https://{env}.trainwithjoe.app/ otherwise.
# REGISTER_URL=https://trainwithjoe.app/

# AWS Region of the Cognito user pool.
AWS_REGION=eu-central-1

# Cognito app client id — only needed if you use the programmatic ConfirmSignUp /
# InitiateAuth helpers in helpers/auth.ts. The default spec confirms the account
# IN THE BROWSER (train-with-joe has an in-page verification code field), so this
# is optional for the happy-path run.
COGNITO_CLIENT_ID=

# Cognito user pool id — only needed for the OPTIONAL best-effort admin cleanup
# (AdminDeleteUser). Requires admin AWS credentials in the environment too.
# train-with-joe has NO join_page /delete surface, so this is the only automated
# cleanup path available.
COGNITO_USER_POOL_ID=

# Skip the interactive stdin prompt and use this verification code directly.
# Useful for re-runs or non-interactive execution once you have the emailed code.
# CONFIRMATION_CODE=

# Force a specific registration email instead of a random plus-addressed one.
# Default pattern: lockhead+<random>@lockhead.info
# REGISTRATION_EMAIL=
